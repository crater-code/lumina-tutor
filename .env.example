# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# OpenAI API Key (for conversational responses)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/books.db

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, chromadb
VECTOR_STORE_PATH=./data/vector_store

# Embedding Model Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM Configuration
LLM_PROVIDER=gemini  # Options: gemini, ollama, huggingface
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash  # Options: gemini-1.5-flash, gemini-1.5-pro

# Ollama Configuration (if using ollama)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_API_URL=http://localhost:11434

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K_CHUNKS=5
MIN_SIMILARITY_THRESHOLD=0.3

# Logging
LOG_LEVEL=INFO
